; the same program (../MiniSoldat.ml, copied at build time, not a
; second source) in a browser: compiled to JavaScript by js_of_ocaml,
; on the Playground's web platform (its shapes drawn as SVG through
; vdom). No SDL, no Cairo. index.html is its page: MiniSoldat.bc.js
; beside it, the flags after a '?' (index.html?hitboxes&ai=engine).
; See ../dune, and the Makefile's serve and website.
(copy_files# ../MiniSoldat.ml)

(executable
 (name MiniSoldat)
 (libraries
   tiny_libs.core ; Program
   soldat_game soldat_render
   elm_playground
   elm_playground_web) ; implem of virtual elm_playground: the browser
 (modes js)
 (link_flags -no-check-prims))

; the page next to the .bc.js in _build: this folder's 'default' alias
; (what 'dune build' builds here) is the program and its page
(rule
 (alias default)
 (deps index.html MiniSoldat.bc.js)
 (action (progn)))
